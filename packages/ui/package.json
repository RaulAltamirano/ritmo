{
  "name": "@ritmo/ui",
  "version": "1.0.0",
  "type": "module",
  "description": "Ritmo UI Component Library - Accessible Vue 3 Components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:axe": "vitest run --config vitest.axe.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:storybook": "test-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview": "storybook dev --port 6006",
    "clean": "rimraf dist .turbo node_modules/.cache",
    "prebuild": "npm run clean"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.0",
    "lucide-vue-next": "^0.294.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-links": "^9.1.3",
    "@storybook/addon-themes": "^9.1.3",
    "@storybook/vue3-vite": "^9.1.3",
    "@types/node": "^20.19.11",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "axe-core": "^4.10.3",
    "axe-playwright": "^2.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-storybook": "9.1.3",
    "eslint-plugin-vue": "^9.19.0",
    "jest-axe": "^8.0.0",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "storybook": "^9.1.3",
    "tailwindcss": "^3.3.6",
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.0.6"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "accessibility",
    "wcag",
    "a11y",
    "tailwind",
    "typescript"
  ],
  "author": "Ritmo Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ritmo/ui.git"
  },
  "bugs": {
    "url": "https://github.com/ritmo/ui/issues"
  },
  "homepage": "https://github.com/ritmo/ui#readme"
}
