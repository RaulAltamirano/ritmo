# Test Database Configuration with Docker
TEST_DATABASE_URL="postgresql://test:test@localhost:5434/ritmo_test"

# JWT Configuration
JWT_ACCESS_SECRET="test-access-secret-key-2025"
JWT_REFRESH_SECRET="test-refresh-secret-key-2025"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Environment
NODE_ENV="test"

# Logging
LOG_LEVEL="error"
LOG_FORMAT="json"

# Security
BCRYPT_SALT_ROUNDS="10"
MAX_FAILED_LOGIN_ATTEMPTS="5"
LOCKOUT_DURATION_MINUTES="15"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Session Management
SESSION_TIMEOUT_MINUTES="30"
MAX_CONCURRENT_SESSIONS="5"

# Mock Services
MOCK_EMAIL_SERVICE="true"
MOCK_DEVICE_VALIDATION="true"
MOCK_SECURITY_MONITORING="true"

# Cache
REDIS_URL="redis://localhost:6379/1"
CACHE_TTL="3600"

# CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# API Configuration
API_PREFIX="/api"
PORT="0" # Random port for tests
