// =====================================================
// CIRCADIAN RHYTHM ENUMS
// =====================================================

enum CircadianPhaseType {
  slow_activation      // 05-07: Sleep inertia + cortisol awakening response
  morning_focus_peak   // 07-10: Rising alertness, structured focus
  cognitive_peak       // 10-13: Analytical and deep-work peak
  second_productivity  // 13-15: Circasemidian dip, structured tasks
  creative_window      // 15-18: Verbal fluency and creative recovery
  transition           // 18-20: Downshift and consolidation
  introspective        // 20-22: Melatonin onset, reflection and planning
  sleep_preparation    // 22-05: Sleep; melatonin peak and temperature nadir
}

enum CircadianPhaseCategory {
  activation      // Morning activation phases
  performance     // High performance phases
  creative        // Creative and verbal phases
  reflection      // Reflection and planning phases
  rest            // Rest and preparation phases
}

enum CircadianPhasePriority {
  low         // Less critical phases
  medium      // Standard phases
  high        // High performance phases
  critical    // Critical for productivity
}

enum CircadianPhaseStatus {
  active      // Currently active phase
  upcoming    // Next phase
  completed   // Completed phase
  inactive    // Not yet active
}

