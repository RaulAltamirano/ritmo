// =====================================================
// CIRCADIAN RHYTHM ENUMS - 2025 BEST PRACTICES
// =====================================================

enum CircadianPhaseType {
  slow_activation      // 5-7 AM: Slow Activation Phase
  morning_focus_peak  // 7-9 AM: Morning Focus Peak
  cognitive_peak      // 9-12 PM: Cognitive Performance Peak
  second_productivity // 13-15 PM: Second Productivity Peak
  creative_window     // 15-17 PM: Creative/Verbal Window
  transition          // 17-19 PM: Transition Phase
  introspective      // 19-21 PM: Introspective Phase
  sleep_preparation  // 21-23 PM: Sleep Preparation
}

enum CircadianPhaseCategory {
  activation      // Morning activation phases
  performance     // High performance phases
  creative        // Creative and verbal phases
  reflection      // Reflection and planning phases
  rest            // Rest and preparation phases
}

enum CircadianPhasePriority {
  low         // Less critical phases
  medium      // Standard phases
  high        // High performance phases
  critical    // Critical for productivity
}

enum CircadianPhaseStatus {
  active      // Currently active phase
  upcoming    // Next phase
  completed   // Completed phase
  inactive    // Not yet active
}
