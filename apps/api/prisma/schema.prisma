model User {
  id                      String                     @id @default(cuid())
  email                   String                     @unique @db.VarChar(255)
  username                String                     @unique @db.VarChar(50)
  passwordHash            String                     @db.VarChar(255)
  firstName               String?                    @db.VarChar(100)
  lastName                String?                    @db.VarChar(100)
  displayName             String?                    @db.VarChar(150)
  avatar                  String?
  bio                     String?
  dateOfBirth             DateTime?
  phone                   String?                    @db.VarChar(20)
  
  // Security & Verification
  isEmailVerified         Boolean                    @default(false)
  isPhoneVerified         Boolean                    @default(false)
  isTwoFactorEnabled      Boolean                    @default(false)
  twoFactorSecret         String?                    @db.VarChar(255)
  backupCodes             String[]
  
  // Account Status
  status                  UserStatus                 @default(active)
  role                    UserRole                   @default(user)
  isActive                Boolean                    @default(true)
  isDeleted               Boolean                    @default(false)
  
  // Preferences
  timezone                String                     @default("UTC") @db.VarChar(50)
  language                String                     @default("es") @db.VarChar(10)
  locale                  String                     @default("es-ES") @db.VarChar(10)
  theme                   Theme                      @default(system)
  emailNotifications      EmailNotificationSettings?
  
  // Security Tracking
  lastLoginAt             DateTime?
  lastPasswordChange      DateTime                   @default(now())
  lastActivityAt          DateTime                   @default(now())
  failedLoginAttempts     Int                        @default(0)
  lockedUntil             DateTime?
  passwordHistory         PasswordHistory[]
  
  // Timestamps
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  
  // Relations
  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  securityLogs            SecurityLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  phoneVerificationTokens PhoneVerificationToken[]
  activities              Activity[]
  tasks                   Task[]
  categories              Category[]
  workSessions            WorkSession[]
  preferences             UserPreferences?
  
  // Circadian Rhythm Relations
  circadianPhasePreferences CircadianPhasePreference[]
  circadianPhaseSessions   CircadianPhaseSession[]
  
  // Indexes
  @@index([email, isActive])
  @@index([username, isActive])
  @@index([status, isActive])
  @@index([createdAt])
  @@map("users")
}

model UserPreferences {
  id                    String   @id @default(cuid())
