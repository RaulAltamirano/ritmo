{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "es2020",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~/components/*": ["components/*"],
      "~/composables/*": ["composables/*"],
      "~/stores/*": ["stores/*"],
      "~/utils/*": ["utils/*"],
      "~/types/*": ["types/*"],
      "~/layouts/*": ["layouts/*"],
      "~/pages/*": ["pages/*"],
      "~/plugins/*": ["plugins/*"],
      "~/middleware/*": ["middleware/*"],
      "~/assets/*": ["assets/*"],
      "~/public/*": ["public/*"],
      "@/*": ["./*"],
      "@components/*": ["components/*"],
      "@composables/*": ["composables/*"],
      "@stores/*": ["stores/*"],
      "@utils/*": ["utils/*"],
      "@types/*": ["types/*"],
      "@layouts/*": ["layouts/*"],
      "@pages/*": ["pages/*"],
      "@plugins/*": ["plugins/*"],
      "@middleware/*": ["middleware/*"],
      "@assets/*": ["assets/*"],
      "@public/*": ["public/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", ".nuxt", "dist"]
}
