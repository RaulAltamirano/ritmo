{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ES2020",
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "~/components/*": ["components/*"],
      "~/composables/*": ["composables/*"],
      "~/stores/*": ["stores/*"],
      "~/utils/*": ["utils/*"],
      "~/types/*": ["types/*"],
      "~/layouts/*": ["layouts/*"],
      "~/pages/*": ["pages/*"],
      "~/plugins/*": ["plugins/*"],
      "~/middleware/*": ["middleware/*"],
      "~/assets/*": ["assets/*"],
      "~/public/*": ["public/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue"],
  "exclude": ["node_modules", ".nuxt", "dist"]
}
