{
  "name": "@ritmo/landing",
  "version": "1.0.0",
  "description": "Ritmo landing page built with Vue.js 3 and Vite",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.1.1",
    "@ritmo/shared": "workspace:*",
    "@ritmo/ui": "workspace:*",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^9.28.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.0.6"
  }
}
